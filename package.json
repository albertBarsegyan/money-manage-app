{
  "name": "money-manage-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:mobile": "node scripts/build-mobile.mjs",
    "start": "next start",
    "android:sync": "npm run build:mobile && cap sync android",
    "android:open": "cap open android",
    "android:build:debug": "cd android && ./gradlew assembleDebug",
    "android:build:release": "cd android && ./gradlew assembleRelease",
    "android:build:bundle": "cd android && ./gradlew bundleRelease",
    "lint": "eslint src tests scripts eslint.config.mjs next.config.ts capacitor.config.ts",
    "format": "eslint src tests scripts eslint.config.mjs next.config.ts capacitor.config.ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "tsc --target ES2020 --module commonjs --moduleResolution node --strict --esModuleInterop --skipLibCheck --types node --outDir /tmp/finora-local-tests tests/finance.test.ts && node /tmp/finora-local-tests/tests/finance.test.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@hookform/resolvers": "^7.0.3",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.4.2",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "shadcn": "^1.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
